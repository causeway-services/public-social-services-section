[Unit]
Description=Place newly public owned YouTube videos in Turntide chatter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/info/lib/emsenn/services/561-group/services/public-services-section/services/public-social-services-section/services/public-education-services-section
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOUSE_ROOT=%h/info
Environment=TTI_YOUTUBE_CHANNELS=climate-place-by-place,emsenn0
ExecStart=%h/.local/bin/node --import %h/info/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-code-engineering-services-section/services/javascript-engineering-services-section/services/javascript-node-services-section/scripts/register-house-resolver.mjs scripts/syndicate-to-turntide.mjs --live
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true

