[Unit]
Description=Fill education channel publication schedules and retain production state
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/info/lib/emsenn/services/561-group/services/public-services-section/services/public-social-services-section/services/public-education-services-section
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOUSE_ROOT=%h/info
# A failed lesson is reported in the journal; the state it reached is still retained.
ExecStart=%h/.local/bin/node --import %h/info/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-code-engineering-services-section/services/javascript-engineering-services-section/services/javascript-node-services-section/scripts/register-house-resolver.mjs src/cli.mjs produce all
ExecStopPost=%h/.local/bin/node --import %h/info/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-code-engineering-services-section/services/javascript-engineering-services-section/services/javascript-node-services-section/scripts/register-house-resolver.mjs scripts/checkpoint.mjs
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
