{
  "courseId": "causality-and-kinematic-space",
  "revision": 1,
  "title": "Causality and Kinematic Space",
  "purpose": "Build kinematic space from causal order and Lorentzian geometry, then connect its regional geometry to information-theoretic observables.",
  "audience": "Curious adults prepared to learn definitions and follow constructions; no presumed specialist credential.",
  "competencies": [
    {
      "id": "causal-order",
      "statement": "Represent causal comparability as a partial order without smuggling in metric distance."
    },
    {
      "id": "lorentzian-causality",
      "statement": "Use light cones, timelike separation, and causal diamonds correctly."
    },
    {
      "id": "interval-construction",
      "statement": "Construct points or regions of kinematic space from intervals or geodesics."
    },
    {
      "id": "region-geometry",
      "statement": "Interpret geometry on a space whose points represent regions or intervals."
    },
    {
      "id": "information-observables",
      "statement": "Relate geometric quantities to information or entropy without overstating the correspondence."
    },
    {
      "id": "construction-critique",
      "statement": "Work examples, locate failure cases, and distinguish established results from open questions."
    }
  ],
  "assessmentLaw": {
    "completion": "Every competency must be demonstrated in a resolvable exercise; watching or playlist membership is not completion.",
    "negativeControl": "At least one exercise must expose an invalid inference from causal order to metric distance."
  },
  "successorRule": "Material changes create a new revision that names this revision; admitted lesson products remain immutable evidence.",
