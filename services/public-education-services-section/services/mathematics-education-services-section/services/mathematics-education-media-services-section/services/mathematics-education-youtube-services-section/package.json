{
  "name": "@emsenn/mathematics-youtube-channel-enterprise",
  "version": "0.1.8",
  "type": "module",
  "description": "Sovereign owner of the curriculum-organized mathematics YouTube channel, its daily cinematic inventory and channel-local release claims.",
  "files": [
    "content/",
    "scripts/",
    "src/"
  ],
  "exports": {
    ".": "./src/channel.mjs",
    "./journal": "./src/journal.mjs",
    "./persistent-notebook-client": "./src/persistent-notebook-client.mjs",
    "./release": "./src/release.mjs",
    "./public-release": "./src/public-release.mjs",
    "./release-notice": "./src/release-notice.mjs",
    "./release-distribution": "./src/release-distribution.mjs",
    "./existing-receiver": "./src/existing-receiver.mjs"
  },
  "scripts": {
    "oauth-setup": "node src/oauth-setup.mjs",
    "private-pilot": "node src/private-pilot.mjs",
    "schedule-public": "node src/public-release-cli.mjs --execute-schedule-public",
    "observe-public": "node src/public-release-cli.mjs --observe-public",
    "observe-pending-publication": "node src/observe-pending-publication.mjs",
    "serve-portfolio-status": "node src/serve-status-a2a.mjs",
    "serve-release-distribution": "node src/serve-release-distribution-a2a.mjs",
    "replenish-one-lesson": "node src/replenish-one-lesson.mjs",
    "daily-cinematic": "node src/daily-cinematic-runner.mjs",
    "course-playlist": "node src/course-playlist-projection.mjs",
    "verify-existing-receiver": "node scripts/verify-existing-receiver.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@coesite-operations/release-distribution-commission-a2a-service": "0.1.4",
    "@coesite-operations/release-distribution-processing-a2a-service": "0.1.4",
    "@emsenn/mathematics-curriculum-enterprise": "0.1.7",
    "@emsenn/mathematics-research-enterprise": "0.1.6",
    "@red-cup-engineering/a2a-agent-card-discovery-service": "1.0.13",
    "@red-cup-engineering/a2a-channel-portfolio-status-service": "1.0.7",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.1.3",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.5",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.10",
    "@red-cup-engineering/json-byte-carrier-service": "0.1.0",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.7",
    "@red-cup-engineering/semantic-record-journal-service": "0.1.8",
    "@red-cup-engineering/youtube-services-section": "0.1.3"
  },
  "keywords": [
    "sovereign-state-enterprise",
    "youtube",
    "mathematics"
  ],
  "license": "UNLICENSED"
}
