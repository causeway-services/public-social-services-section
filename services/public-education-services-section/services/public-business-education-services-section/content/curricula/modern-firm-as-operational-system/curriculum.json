{
  "courseId": "modern-firm-as-operational-system",
  "revision": 1,
  "title": "The Modern Firm as an Operational System",
  "promise": "Enable an operator or serious student to connect strategy, customers, operations, accounting, organization, technology, governance, and learning as one evidence-producing system without mistaking fashionable practice for universal law.",
  "audience": "operators, founders, managers, analysts, and advanced students",
  "competencies": [
    {
      "id": "value-and-demand",
      "description": "Relate value propositions and demand evidence to a situated business model."
    },
    {
      "id": "operations",
      "description": "Model processes, constraints, quality, capacity, and coordination cost."
    },
    {
      "id": "financial-reasoning",
      "description": "Use accounting, cash, unit economics, and capital allocation without confusing measures with value."
    },
    {
      "id": "organization-and-governance",
      "description": "Analyze incentives, decision rights, controls, obligations, and stakeholder exposure."
    },
    {
      "id": "adaptive-practice",
      "description": "Design evidence, review, correction, and strategy-learning loops."
    }
  ],
  "correctionPolicy": "append a new course revision; never edit admitted lesson truth in place",
