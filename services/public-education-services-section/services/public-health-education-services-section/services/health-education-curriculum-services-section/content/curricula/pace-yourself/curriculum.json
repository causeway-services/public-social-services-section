{
  "courseId": "pace-yourself",
  "revision": 1,
  "title": "PACE Yourself",
  "promise": "Enable a person living with infection-associated chronic illness, or someone caring for them, to run the daily Pause-Attune-Care-Engage loop inside their own energy envelope and to read the evidence behind each step honestly.",
  "audience": "people with infection-associated chronic illness (ME/CFS, long COVID, and related post-viral conditions) and their caregivers",
  "competencies": [
    {
      "id": "pause",
      "description": "Set an activity ceiling in advance of the felt limit, using the person's own history rather than a symptom felt at the threshold."
    },
    {
      "id": "attune",
      "description": "Read deviation from one's own baseline across related systems, citing every heuristic as a heuristic and never as a diagnosis."
    },
    {
      "id": "care",
      "description": "Apply relation-repairing self-management practices — orthostatic management, sleep, hydration, sensory load — each labeled by its own evidence status."
    },
    {
      "id": "engage",
      "description": "Re-enter activity on symptom-contingent terms, advancing only when recovery from the prior exertion is complete, never on a schedule."
    },
    {
      "id": "reading-the-evidence",
      "description": "Evaluate primary research about one's own illness, including what a normal clinical test does and does not rule out."
    }
  ],
  "correctionPolicy": "append a new course revision; never edit admitted lesson truth in place",
