{
  "name": "@emsenn/http-server",
  "version": "0.0.0",
  "type": "module",
  "description": "HTTP server computing service library: application types, response representations, routing composition, middleware, Node server startup, and HTTP edge/platform helpers.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    },
    "./edge": {
      "types": "./dist/server/edge/index.d.mts",
      "import": "./dist/server/edge/index.mjs"
    },
    "./mesh": {
      "types": "./dist/server/mesh/index.d.mts",
      "import": "./dist/server/mesh/index.mjs"
    },
    "./platform": {
      "types": "./dist/server/platform/index.d.mts",
      "import": "./dist/server/platform/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/animating": "0.0.0",
    "@emsenn/computing-with-http": "0.0.0",
    "@emsenn/relating": "0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "sideEffects": false
}
