{
  "name": "@causeway-services/koios-news-service-section",
  "version": "0.0.7",
  "type": "module",
  "description": "News-domain settlement services for warrant-preserving publications.",
  "bin": {
    "describe-service": "./src/service-section.mjs",
    "settle-message": "./src/service-section.mjs",
    "koios-news-production-audit": "./bin/koios-news-production-audit.mjs",
    "koios-news-production-recovery": "./bin/koios-news-production-recovery.mjs",
    "koios-news-routine-operation": "./bin/koios-news-routine-operation.mjs",
    "solicit-admissible-research-packet": "./src/contract-admissible-research-packet.mjs",
    "invoke-admissible-research-packet": "./src/contract-admissible-research-packet.mjs",
    "solicit-licensed-editorial-state": "./src/contract-licensed-editorial-state.mjs",
    "invoke-licensed-editorial-state": "./src/contract-licensed-editorial-state.mjs",
    "settle-mathematics-research-delivery": "./src/contract-mathematics-research-intake.mjs"
  },
  "scripts": {
    "check": "node --check bin/koios-news-production-audit.mjs && node --check bin/koios-news-production-recovery.mjs && node --check bin/koios-news-routine-operation.mjs && node --check src/production-audit.mjs && node --check src/production-recovery.mjs && node --check src/contract-licensed-editorial-state.mjs && node --check src/contract-admissible-research-packet.mjs && node --check src/contract-mathematics-research-intake.mjs && node --check src/service-section.mjs",
    "describe": "node src/service-section.mjs describe",
    "settle": "node src/service-section.mjs settle-message",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/semantic-content-identify-service": "0.2.7",
    "@red-cup-engineering/semantic-record-journal-service": "0.1.11"
  },
  "scheduledActivityDelivery": {
    "runtimeFiles": {
      "koios-news-routine-operation": [
        "config/routine-operation.json",
        "src/routine-job-queue.mjs",
        "routine-publication-current/src/routine-publication.mjs",
        "static-delivery-current/src/publication.mjs",
        "services/editorial-publication-authority/src/editorial-publication-authority.mjs"
      ]
    }
  },
  "devDependencies": {
    "@emsenn/mathematics-research-enterprise": "0.1.6"
  },
  "files": [
    "bin/",
    "config/",
    "routine-publication-current/src/",
    "static-delivery-current/src/",
    "services/editorial-publication-authority/src/",
    "src/",
    "test/",
    "package.json"
  ]
}
