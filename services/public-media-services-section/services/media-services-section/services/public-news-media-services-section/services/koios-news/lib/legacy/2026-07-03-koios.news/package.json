{
  "name": "@koios-news/koios-news",
  "version": "0.0.1",
  "type": "module",
  "description": "Koios.News \u2014 a general news publication with systems-analysis depth: pages, feeds, sitemaps, NewsArticle JSON-LD, ad slots, and accountable first-party attention over its own corpus.",
  "bin": {
    "operate-activitypub-inbox": "./dist/operate-activitypub-inbox.mjs",
    "prepare-article50-provenance": "./dist/prepare-article50-provenance.mjs",
    "settle-issue-pulse": "./dist/issue-pulse.mjs",
    "operate-keyword-research": "./dist/operate-keyword-research.mjs",
    "operate-issue": "./dist/operate-issue.mjs",
    "operate-learning-pulse": "./dist/operate-learning-pulse.mjs",
    "operate-attention-import": "./dist/operate-attention-import.mjs",
    "operate-aads-performance-import": "./dist/operate-aads-performance-import.mjs",
    "operate-search-demand-import": "./dist/operate-search-demand-import.mjs",
    "operate-repair-pulse": "./dist/operate-repair-pulse.mjs",
    "operate-correction": "./dist/correction.mjs",
    "operate-newsroom-repair": "./dist/operate-newsroom-repair.mjs",
    "solicit-participation": "./dist/venture-participation.mjs",
    "invoke-participation": "./dist/venture-participation.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prepare:editorial-context": "node scripts/prepare-editorial-pipeline-context.mjs",
    "check": "npm run prepare:editorial-context && tsc --noEmit",
    "build": "npm run prepare:editorial-context && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "verify:isolated": "node scripts/prepare-editorial-pipeline-context.mjs && tsc --noEmit && node scripts/prepare-editorial-pipeline-context.mjs && tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "rebuild": "npm run clean && npm run build",
    "serve": "npm run build && node dist/server.mjs",
    "serve:newsroom": "npm run build && node dist/newsroom-server.mjs",
    "serve:cable": "npm run build && node dist/cable-server.mjs",
    "cable:ingest": "npm run build && node dist/cable-ingest.mjs",
    "source:cycle": "npm run build && node dist/source-cycle.mjs",
    "issue:pulse": "npm run build && node dist/issue-pulse.mjs",
    "clockkeeper:contract": "npm run build && node dist/contract-clockkeeper.mjs",
    "assignment:backlog": "npm run build && node dist/settle-assignment-backlog.mjs",
    "newsroom:pulse": "npm run build && node dist/operate-issue.mjs",
    "newsroom:assignment": "npm run build && node dist/newsroom-circuit.mjs",
    "learning:pulse": "npm run build && node dist/learning-pulse.mjs",
    "source:submit": "npm run build && node dist/submit-source.mjs",
    "editorial:judge": "npm run build && node dist/editorial-judge.mjs",
    "editorial:recover": "npm run build && node dist/editorial-recover.mjs",
    "editorial:reproject": "npm run build && node dist/editorial-reproject.mjs",
    "writer:replay": "npm run build && node dist/writer-replay.mjs",
    "draft:repair": "npm run build && node dist/draft-repair.mjs",
    "correction": "npm run build && node dist/correction.mjs",
    "correction:prove": "npm run build && node dist/correction-proof.mjs",
    "editor:repair": "npm run build && node dist/settle-editor-repairs.mjs",
    "discover": "npm run build && node dist/discover.mjs",
    "deploy:doctor": "npm run build && node dist/deploy-doctor.mjs",
    "deploy:plan": "npm run build && node dist/deploy-doctor.mjs --plan",
    "deploy:stage": "npm run build && node dist/deploy-doctor.mjs --stage",
    "deploy:rehearse": "npm run build && node dist/deploy-doctor.mjs --rehearse",
    "deploy:ship": "npm run build && node dist/deploy-doctor.mjs --ship",
    "deploy:remote-check": "npm run build && node dist/deploy-doctor.mjs --remote-check",
    "deploy:self-check": "npm run build && node dist/deploy-doctor.mjs --self-check",
    "deploy:probe": "node scripts/deploy-probe.mjs",
    "shadow:build": "npm run build && node dist/static-shadow.mjs --out .static/koios.news --replace",
    "provenance:prepare": "npm run build && node dist/prepare-article50-provenance.mjs",
    "shadow:witness-live": "npm run build && node dist/live-publication-witness.mjs",
    "shadow:verify": "npm run build && node dist/static-shadow.mjs --verify",
    "candidate:build": "npm run build && node dist/static-shadow.mjs --profile cutover-candidate --out .static/koios.news-candidate --replace",
    "candidate:verify": "npm run build && node dist/static-shadow.mjs --profile cutover-candidate --verify",
    "candidate:compare-shadow": "npm run build && node dist/static-profile-parity.mjs",
    "shadow:compare-live": "npm run build && node dist/shadow-parity.mjs",
    "shadow:cloudflare-dry-run": "npm run build && node dist/cloudflare-static-delivery.mjs",
    "candidate:deliver-preview": "npm run build && node dist/cloudflare-static-delivery.mjs",
    "candidate:settle-mutable-routes": "npm run build && node dist/mutable-route-dispositions.mjs",
    "candidate:prove-preview": "npm run build && node dist/preview-parity.mjs",
    "mill": "content-farm",
    "demand:pull": "content-demand-pull --property=sc-domain:koios.news --out=data/records/search-console.json",
    "desk:enqueue": "npm run build && node dist/desk.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "import": "./dist/content.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./newsroom": {
      "types": "./dist/newsroom-site.d.mts",
      "import": "./dist/newsroom-site.mjs"
    },
    "./newsroom/departments": {
      "types": "./dist/newsroom/departments.d.mts",
      "import": "./dist/newsroom/departments.mjs"
    },
    "./administrating": {
      "types": "./dist/administrating/index.d.mts",
      "import": "./dist/administrating/index.mjs"
    },
    "./administrating/developing": {
      "types": "./dist/administrating/developing/index.d.mts",
      "import": "./dist/administrating/developing/index.mjs"
    },
    "./administrating/deploying": {
      "types": "./dist/administrating/deploying/index.d.mts",
      "import": "./dist/administrating/deploying/index.mjs"
    },
    "./researching": {
      "types": "./dist/researching/index.d.mts",
      "import": "./dist/researching/index.mjs"
    },
    "./researching/sourcing": {
      "types": "./dist/researching/sourcing/index.d.mts",
      "import": "./dist/researching/sourcing/index.mjs"
    },
    "./researching/writing": {
      "types": "./dist/researching/writing/index.d.mts",
      "import": "./dist/researching/writing/index.mjs"
    },
    "./researching/writing/manuscripts": {
      "types": "./dist/researching/writing/manuscripts.d.mts",
      "import": "./dist/researching/writing/manuscripts.mjs"
    },
    "./researching/writing/assignments": {
      "types": "./dist/researching/writing/assignments.d.mts",
      "import": "./dist/researching/writing/assignments.mjs"
    },
    "./researching/writing/editing": {
      "types": "./dist/researching/writing/editing/index.d.mts",
      "import": "./dist/researching/writing/editing/index.mjs"
    },
    "./researching/writing/editing/standards": {
      "types": "./dist/researching/writing/editing/standards.d.mts",
      "import": "./dist/researching/writing/editing/standards.mjs"
    },
    "./researching/writing/editing/publishing": {
      "types": "./dist/researching/writing/editing/publishing/index.d.mts",
      "import": "./dist/researching/writing/editing/publishing/index.mjs"
    },
    "./researching/writing/editing/publishing/managing": {
      "types": "./dist/researching/writing/editing/publishing/managing/index.d.mts",
      "import": "./dist/researching/writing/editing/publishing/managing/index.mjs"
    },
    "./cable": {
      "types": "./dist/cable-app.d.mts",
      "import": "./dist/cable-app.mjs"
    },
    "./package.json": "./package.json",
    "./desk": {
      "types": "./dist/desk.d.mts",
      "import": "./dist/desk.mjs"
    }
  },
  "dependencies": {
    "@red-cup-engineering/relation-model-notation-cbor-codec": "0.1.0",
    "@red-cup-engineering/relation-model-notation-conformance": "7.0.0",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.0",
    "@561-group/inference-work-lot-service": "4.0.0",
    "@red-cup-engineering/c2pa-services-section": "1.0.0",
    "@lenticule-science/communicating": "0.0.0",
    "@red-cup-engineering/computing-with-the-web": "0.0.0",
    "@red-cup-engineering/http-server": "0.0.0",
    "@red-cup-engineering/organizing-a-content-farm": "0.0.0",
    "@red-cup-engineering/organizing-a-content-mill": "0.0.0",
    "@red-cup-engineering/organizing-a-newscable": "0.0.0",
    "@red-cup-engineering/organizing-a-newswire": "0.0.0",
    "@red-cup-engineering/producing-content": "0.0.1",
    "@lenticule-science/relating": "0.0.0",
    "@lenticule-science/rwil-rdf-projection-service": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "wrangler": "4.112.0"
  },
  "sideEffects": false,
  "keywords": [
    "sovereign-state-enterprise"
  ],
  "x-agentic-metro-enterprise": {
    "node-id": "koios.news",
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "operation-catalog": {
      "operate-activitypub-inbox": {
        "contract": "koios.news/activitypub-inbox-items/v1",
        "accepts": "the authenticated ActivityStreams OrderedCollection exposed by Koios's hired ActivityPub provider",
        "returns": "a local inbox pull tally followed by at most one Koios newsroom settlement",
        "timeoutMs": 1800000
      },
      "operate-keyword-research": {
        "contract": "koios.news/keyword-opportunity-research/v1",
        "accepts": "an admitted Journalism Commissioning Create<KeywordOpportunityResearchOrder> on stdin",
        "returns": "ActivityStreams Accept<KeywordOpportunityResearchSettlement>|Reject",
        "economic-role": "Koios Keyword Research sells a non-warranting opportunity brief to Koios Journalism Commissioning through the internal market",
        "timeoutMs": 120000
      },
      "commissioned-journalism": {
        "contract": "koios.news/commissioned-journalism/v1",
        "accepts": "one publication-owned assignment descended from an exact keyword-opportunity brief",
        "returns": "a digest-bound warranted article package or no sale",
        "economic-role": "Koios Journalism Commissioning sells an editorially admitted article candidate to Koios Publishing and Ad Inventory",
        "timeoutMs": 1800000
      },
      "article-ad-inventory": {
        "contract": "koios.news/article-ad-inventory/v1",
        "accepts": "one Cloudflare-released article candidate plus independent public witness",
        "returns": "a bounded external ad-inventory lot awaiting advertiser or demand-provider receipts",
        "economic-role": "Koios Publishing and Ad Inventory exposes publicly witnessed placements to outside revenue counterparties without treating readers as the commodity",
        "timeoutMs": 30000
      },
      "settle-issue-pulse": {
        "contract": "koios.news/publication-issue-pulse/v1",
        "accepts": "externally authored ActivityStreams Create<NewsroomIssueDemand> on stdin",
        "returns": "ActivityStreams Accept<IssuePulseSettlement>|Reject",
        "timeoutMs": 120000
      },
      "operate-issue": {
        "contract": "koios.news/publication-cycle/v1",
        "accepts": "ScheduleDelivery delivery of Koios's standing internal publication-service order as ActivityStreams Create<NewsroomIssueDemand> on stdin",
        "returns": "ActivityStreams Accept<PublicationCycleSettlement>|Question<PublicationCycleSettlement>|Reject<IssuePulseSettlement|PublicationCycleSettlement>",
        "economic-role": "internal node service sold by Koios publication operations to the Koios market micro-enterprise; reader choice and outside revenue, not ScheduleDelivery delivery, settle value",
        "timeoutMs": 1800000
      },
      "operate-learning-pulse": {
        "contract": "koios-news/newsroom-learning-pulse/v1",
        "accepts": "an admitted ScheduleDelivery ActivityStreams Create<NewsroomLearningDemand>",
        "returns": "ActivityStreams Accept<NewsroomLearningSettlement>|Reject",
        "timeoutMs": 120000
      },
      "operate-attention-import": {
        "contract": "koios-news/attention-import/v1",
        "accepts": "an admitted ScheduleDelivery ActivityStreams Create<AttentionImportDemand>",
        "returns": "ActivityStreams Accept<AttentionImportSettlement>|Reject",
        "timeoutMs": 120000
      },
      "operate-aads-performance-import": {
        "contract": "koios-news/aads-performance-import/v1",
        "accepts": "an admitted ScheduleDelivery ActivityStreams Create<AAdsPerformanceImportDemand>",
        "returns": "ActivityStreams Accept<AAdsPerformanceImportSettlement>|Reject",
        "timeoutMs": 120000
      },
      "operate-search-demand-import": {
        "contract": "koios-news/search-demand-import/v1",
        "accepts": "an admitted ScheduleDelivery ActivityStreams Create<SearchDemandImportDemand>",
        "returns": "ActivityStreams Accept<SearchDemandImportSettlement>|Reject with a durable provider obstruction",
        "timeoutMs": 120000
      },
      "operate-repair-pulse": {
        "contract": "koios-news/newsroom-repair-pulse/v1",
        "accepts": "an admitted ScheduleDelivery ActivityStreams Create<NewsroomRepairPulseDemand>",
        "returns": "ActivityStreams Accept<NewsroomRepairPulseSettlement>|Question|Reject",
        "timeoutMs": 1800000
      },
      "operate-correction": {
        "contract": "koios.news/correction-publication/v1",
        "accepts": "an Editor-in-Chief-authorized correction transaction naming exact prior and corrected evidence",
        "returns": "CorrectionPublicationSettlement released through cloudflare-primary-static-release/v1 or release-obstructed for automatic retry",
        "timeoutMs": 900000
      },
      "operate-newsroom-repair": {
        "contract": "koios.news/newsroom-repair-replay/v2",
        "accepts": "one exact terminal Koios assignment id with a supported learning move",
        "returns": "NewsroomRepairReplaySettlement with provider repair, successor replay, and optional Cloudflare release",
        "timeoutMs": 1800000
      },
      "solicit-participation": {
        "contract": "koios.news/venture-participation/v1",
        "accepts": "ActivityStreams Offer<VentureParticipationSolicitation> carrying one exact Leader VentureParticipationIntent",
        "returns": "ActivityStreams Offer<ExecutableParticipationOffer>|Question|Reject",
        "timeoutMs": 30000
      },
      "invoke-participation": {
        "contract": "koios.news/venture-participation/v1",
        "accepts": "ActivityStreams Accept<VentureParticipationContract> with an attenuated provider-local-write capability",
        "returns": "ActivityStreams Accept<KoiosVentureParticipationResult>|Reject",
        "timeoutMs": 30000
      }
    }
  }
}
