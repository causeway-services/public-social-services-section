{
  "name": "@emsenn/koios.news",
  "version": "0.0.1",
  "type": "module",
  "description": "Koios.News — a general news publication with systems-analysis depth: pages, feeds, sitemaps, NewsArticle JSON-LD, ad slots, and accountable first-party attention over its own corpus.",
  "bin": {
    "settle-issue-pulse": "./dist/issue-pulse.mjs",
    "operate-issue": "./dist/operate-issue.mjs",
    "operate-correction": "./dist/correction.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "verify": "pnpm run check && pnpm test",
    "rebuild": "pnpm run clean && pnpm run build",
    "serve": "pnpm run build && node dist/server.mjs",
    "serve:newsroom": "pnpm run build && node dist/newsroom-server.mjs",
    "serve:cable": "pnpm run build && node dist/cable-server.mjs",
    "cable:ingest": "pnpm run build && node dist/cable-ingest.mjs",
    "source:cycle": "pnpm run build && node dist/source-cycle.mjs",
    "issue:pulse": "pnpm run build && node dist/issue-pulse.mjs",
    "clockkeeper:contract": "pnpm run build && node dist/contract-clockkeeper.mjs",
    "assignment:backlog": "pnpm run build && node dist/settle-assignment-backlog.mjs",
    "newsroom:pulse": "pnpm run build && node dist/operate-issue.mjs",
    "newsroom:assignment": "pnpm run build && node dist/newsroom-circuit.mjs",
    "learning:pulse": "pnpm run build && node dist/learning-pulse.mjs",
    "source:submit": "pnpm run build && node dist/submit-source.mjs",
    "editorial:judge": "pnpm run build && node dist/editorial-judge.mjs",
    "editorial:recover": "pnpm run build && node dist/editorial-recover.mjs",
    "editorial:reproject": "pnpm run build && node dist/editorial-reproject.mjs",
    "writer:replay": "pnpm run build && node dist/writer-replay.mjs",
    "draft:repair": "pnpm run build && node dist/draft-repair.mjs",
    "correction": "pnpm run build && node dist/correction.mjs",
    "correction:prove": "pnpm run build && node dist/correction-proof.mjs",
    "editor:repair": "pnpm run build && node dist/settle-editor-repairs.mjs",
    "discover": "pnpm run build && node dist/discover.mjs",
    "deploy:doctor": "pnpm run build && node dist/deploy-doctor.mjs",
    "deploy:plan": "pnpm run build && node dist/deploy-doctor.mjs --plan",
    "deploy:stage": "pnpm run build && node dist/deploy-doctor.mjs --stage",
    "deploy:rehearse": "pnpm run build && node dist/deploy-doctor.mjs --rehearse",
    "deploy:ship": "pnpm run build && node dist/deploy-doctor.mjs --ship",
    "deploy:remote-check": "pnpm run build && node dist/deploy-doctor.mjs --remote-check",
    "deploy:self-check": "pnpm run build && node dist/deploy-doctor.mjs --self-check",
    "deploy:probe": "node scripts/deploy-probe.mjs",
    "shadow:build": "pnpm run build && node dist/static-shadow.mjs --out .static/koios.news --replace",
    "shadow:witness-live": "pnpm run build && node dist/live-publication-witness.mjs",
    "shadow:verify": "pnpm run build && node dist/static-shadow.mjs --verify",
    "candidate:build": "pnpm run build && node dist/static-shadow.mjs --profile cutover-candidate --out .static/koios.news-candidate --replace",
    "candidate:verify": "pnpm run build && node dist/static-shadow.mjs --profile cutover-candidate --verify",
    "candidate:compare-shadow": "pnpm run build && node dist/static-profile-parity.mjs",
    "shadow:compare-live": "pnpm run build && node dist/shadow-parity.mjs",
    "shadow:cloudflare-dry-run": "pnpm run build && node dist/cloudflare-static-delivery.mjs",
    "candidate:deliver-preview": "pnpm run build && node dist/cloudflare-static-delivery.mjs",
    "candidate:settle-mutable-routes": "pnpm run build && node dist/mutable-route-dispositions.mjs",
    "candidate:prove-preview": "pnpm run build && node dist/preview-parity.mjs",
    "candidate:inspect-primary": "pnpm run build && node dist/cloudflare-primary-cutover.mjs --mode inspect",
    "ledger:project-provider-usage": "pnpm run build && node dist/project-provider-usage.mjs",
    "mill": "content-farm",
    "demand:pull": "pnpm --filter @emsenn/producing-content... run build && content-demand-pull --property=sc-domain:koios.news --out=data/records/search-console.json",
    "desk:enqueue": "pnpm run build && node dist/desk.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "import": "./dist/content.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./newsroom": {
      "types": "./dist/newsroom-site.d.mts",
      "import": "./dist/newsroom-site.mjs"
    },
    "./newsroom/departments": {
      "types": "./dist/newsroom/departments.d.mts",
      "import": "./dist/newsroom/departments.mjs"
    },
    "./administrating": {
      "types": "./dist/administrating/index.d.mts",
      "import": "./dist/administrating/index.mjs"
    },
    "./administrating/developing": {
      "types": "./dist/administrating/developing/index.d.mts",
      "import": "./dist/administrating/developing/index.mjs"
    },
    "./administrating/deploying": {
      "types": "./dist/administrating/deploying/index.d.mts",
      "import": "./dist/administrating/deploying/index.mjs"
    },
    "./researching": {
      "types": "./dist/researching/index.d.mts",
      "import": "./dist/researching/index.mjs"
    },
    "./researching/sourcing": {
      "types": "./dist/researching/sourcing/index.d.mts",
      "import": "./dist/researching/sourcing/index.mjs"
    },
    "./researching/writing": {
      "types": "./dist/researching/writing/index.d.mts",
      "import": "./dist/researching/writing/index.mjs"
    },
    "./researching/writing/manuscripts": {
      "types": "./dist/researching/writing/manuscripts.d.mts",
      "import": "./dist/researching/writing/manuscripts.mjs"
    },
    "./researching/writing/assignments": {
      "types": "./dist/researching/writing/assignments.d.mts",
      "import": "./dist/researching/writing/assignments.mjs"
    },
    "./researching/writing/editing": {
      "types": "./dist/researching/writing/editing/index.d.mts",
      "import": "./dist/researching/writing/editing/index.mjs"
    },
    "./researching/writing/editing/standards": {
      "types": "./dist/researching/writing/editing/standards.d.mts",
      "import": "./dist/researching/writing/editing/standards.mjs"
    },
    "./researching/writing/editing/publishing": {
      "types": "./dist/researching/writing/editing/publishing/index.d.mts",
      "import": "./dist/researching/writing/editing/publishing/index.mjs"
    },
    "./researching/writing/editing/publishing/managing": {
      "types": "./dist/researching/writing/editing/publishing/managing/index.d.mts",
      "import": "./dist/researching/writing/editing/publishing/managing/index.mjs"
    },
    "./cable": {
      "types": "./dist/cable-app.d.mts",
      "import": "./dist/cable-app.mjs"
    },
    "./package.json": "./package.json",
    "./desk": {
      "types": "./dist/desk.d.mts",
      "import": "./dist/desk.mjs"
    }
  },
  "dependencies": {
    "@emsenn/communicating": "workspace:*",
    "@emsenn/computing-with-the-web": "workspace:*",
    "@emsenn/http-server": "workspace:*",
    "@emsenn/organizing-a-content-farm": "workspace:*",
    "@emsenn/organizing-a-content-mill": "workspace:*",
    "@emsenn/organizing-a-newscable": "workspace:*",
    "@emsenn/organizing-a-newswire": "workspace:*",
    "@emsenn/producing-content": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "wrangler": "4.112.0"
  },
  "sideEffects": false,
  "keywords": [
    "sovereign-state-enterprise"
  ],
  "x-agentic-metro-enterprise": {
    "node-id": "koios.news",
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "operation-catalog": {
      "settle-issue-pulse": {
        "contract": "koios.news/publication-issue-pulse/v1",
        "accepts": "externally authored ActivityStreams Create<NewsroomIssueDemand> on stdin",
        "returns": "ActivityStreams Accept<IssuePulseSettlement>|Reject",
        "timeoutMs": 120000
      },
      "operate-issue": {
        "contract": "koios.news/publication-cycle/v1",
        "accepts": "externally authored ActivityStreams Create<NewsroomIssueDemand> on stdin",
        "returns": "ActivityStreams Accept<PublicationCycleSettlement>|Question<PublicationCycleSettlement>|Reject<IssuePulseSettlement|PublicationCycleSettlement>",
        "timeoutMs": 900000
      },
      "operate-correction": {
        "contract": "koios.news/correction-publication/v1",
        "accepts": "an Editor-in-Chief-authorized correction transaction naming exact prior and corrected evidence",
        "returns": "CorrectionPublicationSettlement released through cloudflare-primary-static-release/v1 or release-obstructed for automatic retry",
        "timeoutMs": 900000
      }
    }
  }
}
