rl\":\"https://timesofindia.indiatimes.com/entertainment/english/hollywood/box-office/the-odyssey-storms-box-office-with-a-usd-264-1-million-global-debut-dethrones-the-dark-knight-rises-as-christopher-nolans-highest-film-opening/articleshow/132501487.cms\",\"evidenceLexemes\":[\"dedicating\",\"Odyssey\",\"screens\",\"three\",\"entirely\",\"weeks\",\"IMAX\"],\"quantities\":[],\"sourceAssertionDigest\":\"sha256:c95c0f4283208979424ea2185e39e4066e8ec99ec7e135b08ac38dbaafc13b72\",\"force\":\"alleges\",\"attribution\":\"required\",\"scope\":\"no broader than this source assertion\",\"sourcePublished\":\"2026-07-19T22:49:00.000Z\"},{\"id\":\"claim:public-web:4a3c23d9f60612c3103fd53cac60f534cdbbf6e500e3d127f6d61bbc031815b1:20\",\"sourceUrl\":\"https://timesofindia.indiatimes.com/entertainment/english/hollywood/box-office/the-odyssey-storms-box-office-with-a-usd-264-1-million-global-debut-dethrones-the-dark-knight-rises-as-christopher-nolans-highest-film-opening/articleshow/132501487.cms\",\"evidenceLexemes\":[\"million\",\"second\",\"distant\",\"place\",\"19\",\"landed\",\"Moana\",\"weekend\",\"third\"],\"quantities\":[\"$19 million\"],\"sourceAssertionDigest\":\"sha256:5f2568acfea00f147cde7b79eb4c4c83e0b15e70518bdc909c858e7d0405c526\",\"force\":\"alleges\",\"attribution\":\"required\",\"scope\":\"no broader than this source assertion\",\"sourcePublished\":\"2026-07-19T22:49:00.000Z\"},{\"id\":\"claim:public-web:bd7c6f1462b3ca8f4d623b38b4e627013f9405d16a050668ba9fa10022d4c550:9\",\"sourceUrl\":\"https://www.latimes.com/entertainment-arts/business/story/2026-07-19/christopher-nolan-the-odyssey-box-office\",\"evidenceLexemes\":[\"need\",\"early\",\"laid\",\"considering\",\"Nolan\",\"Rich\",\"2024\",\"projectionists\",\"way\",\"Chief\",\"easier\",\"told\",\"entire\",\"Gelfond\",\"Imax\",\"getting\",\"film\",\"cameras\",\"he'd\",\"make\",\"including\",\"enough\",\"making\",\"Executive\",\"camera\",\"quieter\",\"trained\",\"first\",\"reloads\",\"lighter\",\"happen\"],\"quantitie