s\":[\"2024\"],\"sourceAssertionDigest\":\"sha256:b8cc640a8c4f3d6e416db3b8b15cf85756190d040294873b51ef03e662061868\",\"force\":\"alleges\",\"attribution\":\"required\",\"scope\":\"no broader than this source assertion\",\"sourcePublished\":\"2026-07-19T17:36:29.367Z\"},{\"id\":\"claim:the-odyssey-becomes-christopher-nolan-s-biggest-global-debut-of-all-time-with-264-million:3\",\"sourceUrl\":\"https://variety.com/2026/film/box-office/the-odyssey-christopher-nolan-biggest-global-debut-1236815981/\",\"evidenceLexemes\":[\"hellip\",\"course\",\"Odyssey\",\"isnâ€™t\"],\"quantities\":[],\"sourceAssertionDigest\":\"sha256:f0eb56faeb08e09b8d8d9bc199abfc5428e8f192eed94df4f59e77bc3cae0103\",\"force\":\"alleges\",\"attribution\":\"required\",\"scope\":\"no broader than this source assertion\",\"sourcePublished\":\"2026-07-19T17:47:17.000Z\"},{\"id\":\"claim:the-odyssey-becomes-christopher-nolan-s-biggest-global-debut-of-all-time-with-264-million:2\",\"sourceUrl\":\"https://variety.com/2026/film/box-office/the-odyssey-christopher-nolan-biggest-global-debut-1236815981/\",\"evidenceLexemes\":[\"R-rated\",\"Itâ€™s\",\"movie\",\"towering\",\"franchise\",\"debut\",\"thatâ€™s\",\"isnâ€™t\",\"part\",\"three\",\"length\",\"hours\",\"nearly\",\"major\"],\"quantities\":[],\"sourceAssertionDigest\":\"sha256:626b7cc4a48098384394be1d840c643a110ee86e5a78a16eafa49e4fafb794a8\",\"force\":\"alleges\",\"attribution\":\"required\",\"scope\":\"no broader than this source assertion\",\"sourcePublished\":\"2026-07-19T17:47:17.000Z\"},{\"id\":\"claim:public-web:4a3c23d9f60612c3103fd53cac60f534cdbbf6e500e3d127f6d61bbc031815b1:19\",\"sourceUrl\":\"https://timesofindia.indiatimes.com/entertainment/english/hollywood/box-office/the-odyssey-storms-box-office-with-a-usd-264-1-million-global-debut-dethrones-the-dark-knight-rises-as-christopher-nolans-highest-film-opening/articleshow/132501487.cms\",\"evidenceLexemes\":[\"career\",\"Rotten\",\"best\",\"Tomatoes\",\"among\",\"95%\",\"Nolan's\",\"Reviews\",\"fr