# Install as ~/.config/emsenn/koios-activitypub.env with mode 0600.
# These paths contain deployment authority; the example contains no secret.
ACTIVITYPUB_KEYS_PATH=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/activitypub/koios-news.json
ACTIVITYPUB_INBOX_BEARER_TOKEN_FILE=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/activitypub/koios-inbox.token
