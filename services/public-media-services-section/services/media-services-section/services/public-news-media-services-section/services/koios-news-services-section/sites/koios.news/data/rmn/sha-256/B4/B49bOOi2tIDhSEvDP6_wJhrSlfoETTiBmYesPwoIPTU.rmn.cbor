{"type":"object","additionalProperties":false,"properties":{"tool":{"type":"string","enum":["submit_editorial_acceptance","submit_revision_request","submit_editorial_refusal"],"description":"Choose acceptance only when no manuscript repair remains; acceptance requires failureLayer=none and requiredRepairs=[]."},"failureLayer":{"type":"string","enum":["sources","assignment","instructions","deterministic-gates","writer-model","draft-repair","none"],"description":"The earliest defective layer. Must be none for submit_editorial_acceptance."},"replayFrom":{"type":"string","minLength":1,"maxLength":120},"summary":{"type":"string","minLength":1,"maxLength":2000},"requiredRepairs":{"type":"array","maxItems":20,"description":"Material manuscript repairs only. Must be an empty array for submit_editorial_acceptance; publication flags are never repairs.","items":{"type":"string","minLength":1,"maxLength":1000}},"repairTools":{"type":"array","maxItems":20,"description":"Executable bounded repairs. Select replace_exact_body_text for one exact unique Markdown-body span. Select repair_editorial_surfaces to have deterministic code regenerate summary and description from the admitted body and prune carrier artifacts. Never address frontmatter bytes with a body tool. Leave empty when replay from an earlier layer or a full prose contribution is genuinely required.","items":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"tool":{"const":"replace_exact_body_text"},"before":{"type":"string","minLength":1,"maxLength":6000},"after":{"type":"string","maxLength":6000}},"required":["tool","before","after"]},{"type":"object","additionalProperties":false,"properties":{"tool":{"const":"repair_editorial_surfaces"}},"required":["tool"]}]}},"report":{"type":"string","minLength":500}},"required":["tool","failureLayer","replayFrom","summary","requiredRepairs","repairTools","report"]}ƒdpairƒhconstant‚dbasefEntityx9ni:///sha-256;f76jtbYJl6oeLEoPl2aijJQNrgn_1Ww1DoDoQKwW55Aƒdpairƒeri