#lang rmn/v2
(map
  ("type" "IndependentEditorialAssessmentLaw")
  ("version" 1)
  ("provider" "urn:ame:independent-editorial-assessment")
  ("precondition" "A sovereign customer supplies exact manuscript bytes, a deterministic standards reading, source and claim evidence, production provenance, and ni-identified policy authorities without filesystem authority.")
  ("operation" "The provider contracts LISS for one schema-bound inference, validates exactly one bounded editorial tool selection, and records its own offer, refusal, and exchange evidence through its hired RWIL/RDF provider.")
  ("postcondition" "The customer receives one validated selection bound to the exact manuscript and editorial context plus upstream evidence; only customer-owned deterministic code may invoke the selected tool or create an editorial judgment.")
  ("refusal" "Refuse filesystem authority, changed manuscript or schema, unvalidated tool selection, provider obstruction, publication authority hidden in prose, customer mutation, or silent resolicitation.")
  ("protocol" "ActivityStreams-2.0")
  ("evidence" "RWIL-RDF"))
