{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turntide-islands-561-group",
  "compatibility_date": "2026-08-29",
  "main": "./worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "turntide-islands.561.group",
      "custom_domain": true
    }
  ]
}
